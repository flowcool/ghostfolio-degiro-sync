# Copy to .env (ignored by Git). Single quotes preserve literal $ and #.
# Personal API key: Bitwarden account settings > Security > Keys.
BW_SERVER=https://vault.bitwarden.com
# For EU cloud: https://vault.bitwarden.eu; for Vaultwarden: your HTTPS URL.
BW_CLIENTID='user.REPLACE_WITH_API_CLIENT_ID'
BW_CLIENTSECRET='REPLACE_WITH_API_CLIENT_SECRET'
BW_PASSWORD='REPLACE_WITH_MASTER_PASSWORD'
# UUID of the Login item containing DEGIRO username, password and TOTP seed.
BW_ITEM_ID=REPLACE_WITH_ITEM_UUID

GHOST_HOST=http://ghostfolio:3333
GHOST_ACCESS_TOKEN='REPLACE_WITH_GHOSTFOLIO_SECURITY_TOKEN'
# Leave GHOST_TOKEN unset when using GHOST_ACCESS_TOKEN.
DEGIRO_ACCOUNT_ID=REPLACE_WITH_NUMERIC_SOURCE_ACCOUNT_ID
GHOST_ACCOUNT_ID=REPLACE_WITH_TARGET_ACCOUNT_ID
GHOST_NETWORK=REPLACE_WITH_EXISTING_DOCKER_NETWORK

DEGIRO_MAPPING_PATH=./mapping.yaml
DEGIRO_STATE_PATH=./state
DRY_RUN=1
# Empty means run once. Example daily schedule: '15 6 * * *'.
CRON=
# Keep no for a one-shot run. With CRON, use unless-stopped.
RESTART_POLICY=no
# Optional failure notifications; empty means disabled.
APPRISE_URLS=
APPRISE_TIMEOUT=10
# Empty uses the release pinned in compose.yaml. Uncomment to follow the latest
# stable release, or set a tag or immutable digest.
# DEGIRO_IMAGE=ghcr.io/flowcool/ghostfolio-degiro-sync:latest
