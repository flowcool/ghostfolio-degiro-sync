{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "enabledManagers": ["pip_requirements", "npm", "github-actions", "dockerfile", "docker-compose"],
  "timezone": "Europe/Zurich",
  "schedule": ["* 0-8 * * 1"],
  "prConcurrentLimit": 3,
  "prHourlyLimit": 2,
  "automerge": false,
  "platformAutomerge": false,
  "dependencyDashboard": true,
  "ignoreUnstable": true,
  "minimumReleaseAgeBehaviour": "timestamp-required",
  "ignoreDeps": ["ghcr.io/flowcool/ghostfolio-degiro-sync", "ghostfolio-degiro-sync"],
  "packageRules": [
    {
      "description": "Keep the complete pinned Python dependency closure together after the review window.",
      "matchManagers": ["pip_requirements"],
      "minimumReleaseAge": "14 days",
      "rangeStrategy": "pin"
    },
    {
      "description": "Keep npm updates behind the review window.",
      "matchManagers": ["npm"],
      "minimumReleaseAge": "14 days"
    },
    {
      "matchManagers": ["pip_requirements"],
      "matchFileNames": ["requirements.txt"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "python-runtime-minor-patch"
    },
    {
      "matchManagers": ["pip_requirements"],
      "matchFileNames": ["requirements-dev.txt"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "python-dev-minor-patch"
    },
    {
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "npm-minor-patch"
    },
    {
      "description": "Preserve the review window for image and CI changes.",
      "matchManagers": ["github-actions", "dockerfile", "docker-compose"],
      "minimumReleaseAge": "3 days",
      "pinDigests": true
    },
    {
      "matchManagers": ["dockerfile", "docker-compose"],
      "matchUpdateTypes": ["minor", "patch", "digest", "pin"],
      "groupName": "images"
    },
    {
      "matchManagers": ["github-actions"],
      "matchDatasources": ["github-tags", "github-digest"],
      "matchUpdateTypes": ["minor", "patch", "digest", "pin"],
      "groupName": "github-actions"
    },
    {
      "description": "Python interpreter migration is a separate reviewed change.",
      "matchManagers": ["dockerfile"],
      "matchPackageNames": ["python"],
      "allowedVersions": "/^3\\.12(?:\\.|-|$)/"
    },
    {
      "matchManagers": ["github-actions"],
      "matchPackageNames": ["python"],
      "allowedVersions": ">=3.12 <3.13"
    },
    {
      "description": "Major upgrades require approval before creating a branch or PR.",
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    },
    {
      "description": "Connector provenance needs explicit compatibility review.",
      "matchPackageNames": ["degiro-connector"],
      "dependencyDashboardApproval": true
    }
  ],
  "osvVulnerabilityAlerts": false,
  "vulnerabilityAlerts": {
    "enabled": false
  }
}
