{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "enabledManagers": ["pip_requirements", "npm", "github-actions", "dockerfile", "docker-compose", "custom.regex"],
  "timezone": "Europe/Zurich",
  "schedule": ["* 0-8 * * 1"],
  "prConcurrentLimit": 3,
  "prHourlyLimit": 2,
  "automerge": false,
  "platformAutomerge": false,
  "dependencyDashboard": true,
  "ignoreUnstable": true,
  "minimumReleaseAgeBehaviour": "timestamp-required",
  "ignoreDeps": ["ghostfolio-degiro-sync"],
  "packageRules": [
    {
      "description": "Keep the complete pinned Python dependency closure together after the review window.",
      "matchManagers": ["pip_requirements"],
      "minimumReleaseAge": "14 days",
      "rangeStrategy": "pin"
    },
    {
      "description": "Keep npm updates behind the review window.",
      "matchManagers": ["npm"],
      "minimumReleaseAge": "14 days"
    },
    {
      "matchManagers": ["pip_requirements"],
      "matchFileNames": ["requirements.txt"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "python-runtime-minor-patch"
    },
    {
      "matchManagers": ["pip_requirements"],
      "matchFileNames": ["requirements-dev.txt"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "python-dev-minor-patch"
    },
    {
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "npm-minor-patch"
    },
    {
      "description": "Preserve the review window for image and CI changes.",
      "matchManagers": ["github-actions", "dockerfile", "docker-compose"],
      "minimumReleaseAge": "3 days",
      "pinDigests": true
    },
    {
      "matchManagers": ["dockerfile", "docker-compose"],
      "matchUpdateTypes": ["minor", "patch", "digest", "pin"],
      "groupName": "images"
    },
    {
      "matchManagers": ["github-actions"],
      "matchDatasources": ["github-tags", "github-digest"],
      "matchUpdateTypes": ["minor", "patch", "digest", "pin"],
      "groupName": "github-actions"
    },
    {
      "description": "Python interpreter migration is a separate reviewed change.",
      "matchManagers": ["dockerfile"],
      "matchPackageNames": ["python"],
      "allowedVersions": "/^3\\.14(?:\\.|-|$)/"
    },
    {
      "matchManagers": ["github-actions"],
      "matchPackageNames": ["python"],
      "allowedVersions": ">=3.14 <3.15"
    },
    {
      "description": "Major upgrades require approval before creating a branch or PR.",
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    },
    {
      "description": "Connector provenance needs explicit compatibility review.",
      "matchPackageNames": ["degiro-connector"],
      "dependencyDashboardApproval": true
    },
    {
      "description": "Own image: one bump PR per stable release, automerged only when required checks pass (tests/test_image_pins.py keeps pins equal).",
      "matchManagers": ["custom.regex"],
      "matchPackageNames": ["ghcr.io/flowcool/ghostfolio-degiro-sync"],
      "groupName": "own image",
      "schedule": ["at any time"],
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "description": "The regex manager owns the own-image pins; no second update path.",
      "matchManagers": ["docker-compose"],
      "matchPackageNames": ["ghcr.io/flowcool/ghostfolio-degiro-sync"],
      "enabled": false
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Own published image pins in compose.yaml and README.md.",
      "managerFilePatterns": ["/^compose\\.yaml$/", "/^README\\.md$/"],
      "matchStrings": ["ghcr\\.io/flowcool/ghostfolio-degiro-sync:(?<currentValue>v\\d+\\.\\d+\\.\\d+)"],
      "depNameTemplate": "ghcr.io/flowcool/ghostfolio-degiro-sync",
      "datasourceTemplate": "docker"
    }
  ],
  "osvVulnerabilityAlerts": false,
  "vulnerabilityAlerts": {
    "enabled": false
  }
}
